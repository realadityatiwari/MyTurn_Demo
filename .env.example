# Placeholders only. Copy to .env (git-ignored) for local use; in production set these in the host's secret manager.
# Never commit real values and never paste a bot token into chat, tickets or logs.
TELEGRAM_BOT_TOKEN=
PORT=5173
HOST=127.0.0.1
# Average minutes per visit used for waiting-time estimates (1-120, default 8)
AVG_SERVICE_MINUTES=8
# Persistence (SQLite file; use a persistent volume in production). The word memory disables persistence.
DATABASE_PATH=server/data/myturn.db
# First initialisation of a NEW database only: demo (sample queue) or empty (clean production start)
SEED_MODE=demo

# --- Authentication (Phase 2) ---
# Staff passwords are NEVER stored in plain text. Generate a hash yourself in a private terminal:  node server/hash-password.js
# then store the printed hash (not the password) as a secret. Leave both empty for local development: the server then accepts the
# clearly labelled DEMO credentials (operator/demo, admin/demo) - verified by the server, but NOT real security.
STAFF_OPERATOR_PASSWORD_HASH=
STAFF_ADMIN_PASSWORD_HASH=
# NODE_ENV=production disables demo credentials, website patient sign-in and scenario reset, and sets Secure cookies.
NODE_ENV=
# demo | disabled (default: demo locally, disabled in production). Website patient sign-in is a simulated-OTP demo.
PATIENT_WEB_MODE=
# Local presenter convenience ONLY (ignored in production): 1 lets scenario/reset/step controls work without an admin sign-in.
DEMO_OPEN_CONTROLS=
# Production only: set to 1 to let admins use the full-demo scenario reset.
ALLOW_PRODUCTION_RESET=
# Only behind a trusted reverse proxy: cf-connecting-ip (Render; Cloudflare's single-IP client header), fly-client-ip (Fly.io) or
# x-forwarded-for (only when you know its hop semantics). It is honoured only when the TCP peer is a private/loopback address.
# Leave empty when the app is directly exposed; never use a client-supplied forwarded header without a trusted proxy in front.
TRUST_PROXY_HEADER=
# Optional: replace the default trusted-proxy ranges (private + loopback) with exact CIDRs, e.g. once the platform proxy range is known.
#   TRUSTED_PROXY_CIDRS=172.16.0.0/12,fdaa::/16
TRUSTED_PROXY_CIDRS=
# cf-connecting-ip (Render) is not documented by Render, so the app only trusts it after a runtime self-check through PUBLIC_ORIGIN proves the proxy
# overwrites a forged value (sign-in is refused until then; /healthz shows "clientIp":"verified"). Set to 1 ONLY after verifying by hand; skips the check.
PROXY_HEADER_VERIFIED=

# --- Production safeguards (Phase 3). With NODE_ENV=production the server REFUSES TO START unless all of these hold ---
# PUBLIC_ORIGIN : the exact public https origin, e.g. https://your-app.example (used for Origin/Host checks; no trailing path)
# STAFF_*_PASSWORD_HASH : at least one valid hash (above)
# DATABASE_PATH : a real file on persistent storage (not "memory")
# Also forced in production: Secure __Host- cookies, HSTS, no demo credentials, no open presenter controls, patient web sign-in off
# unless PATIENT_WEB_MODE=demo is set explicitly, scenario reset off unless ALLOW_PRODUCTION_RESET=1.
PUBLIC_ORIGIN=

# --- Telegram transport (Phase 4A) ---
# polling (default; local development only) | webhook (required in production when TELEGRAM_BOT_TOKEN is set)
TELEGRAM_MODE=
# Webhook secret token: 32-256 characters from A-Z a-z 0-9 _ -  . Generate a random one yourself, keep it private, never commit it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Telegram sends it back in the X-Telegram-Bot-Api-Secret-Token header; the server rejects anything else with 403.
TELEGRAM_WEBHOOK_SECRET=
# Local development only: allow polling to delete a webhook that is registered for the same bot (default: refuse). Prefer
#   node server/telegram-webhook.js delete
TELEGRAM_ALLOW_WEBHOOK_DELETE=

# --- Operations ---
# Set to 1 ONLY while restoring a backup in the container (the entrypoint then runs without opening the database; see DEPLOYMENT.md).
MYTURN_MAINTENANCE=

# --- One root page: isolated demo queue next to the real queue ---
# Production serves an in-memory DEMO queue (sample data, public demo logins) to anonymous visitors; real staff sign-in opens the real queue.
# off = no demo queue in production; on = force it locally. Unset = on in production, off locally.
DEMO_QUEUE=
# Comma-separated numeric Telegram user ids (your own test accounts) whose bot activity goes to the DEMO queue. Unset = every Telegram user is real.
DEMO_TELEGRAM_IDS=
